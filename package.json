{
  "name": "chase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown -p nexrad-worker && wasm-bindgen --target bundler --out-dir src/wasm-worker target/wasm32-unknown-unknown/release/nexrad_worker.wasm && cargo build --release --target wasm32-unknown-unknown -p nexrad-web && wasm-bindgen --target bundler --out-dir src/wasm target/wasm32-unknown-unknown/release/nexrad_web.wasm"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "hls.js": "^1.5.8",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
